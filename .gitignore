# ── Dependências ──
node_modules/

# ── Variáveis de ambiente / segredos ──
.env
.env.local
.env.*.local
*.pem
*.key

# ── Credenciais do Supabase ──
# config.js contém URL e anon key do projeto. Use config.example.js como template.
src/js/config.js

# ── Editor (VS Code) ──
# settings.json é pessoal; extensions.json e launch.json podem ser commitados se necessário
.vscode/settings.json
.vscode/launch.json
.vscode/*.code-snippets
.history/

# ── Sistema operacional ──
# macOS
.DS_Store
._*
.Spotlight-V100
.Trashes

# Windows
Thumbs.db
Thumbs.db:encryptable
Desktop.ini
$RECYCLE.BIN/

# ── Logs e temporários ──
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ── Build / dist (caso venha a usar um bundler no futuro) ──
dist/
build/
.cache/
.parcel-cache/
.vite/

# ── Arquivos locais que não devem ir ao repositório ──
*.xlsx
*.csv.local
