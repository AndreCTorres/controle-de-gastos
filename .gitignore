# ── Dependências ──
node_modules/

# ── Variáveis de ambiente / segredos ──
.env
.env.local
.env.*.local
*.pem
*.key

# ── Supabase config ──
# config.js contém apenas a SUPABASE_URL e a SUPABASE_ANON_KEY.
# A anon key é uma chave PÚBLICA por design — ela é exposta no cliente e visível
# no DevTools por qualquer pessoa. O acesso real aos dados é controlado por RLS
# no Supabase. Não há segredo aqui, por isso o arquivo é versionado normalmente.

# ── Editor (VS Code) ──
# settings.json é pessoal; extensions.json e launch.json podem ser commitados se necessário
.vscode/settings.json
.vscode/launch.json
.vscode/*.code-snippets
.history/

# ── Sistema operacional ──
# macOS
.DS_Store
._*
.Spotlight-V100
.Trashes

# Windows
Thumbs.db
Thumbs.db:encryptable
Desktop.ini
$RECYCLE.BIN/

# ── Logs e temporários ──
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ── Build / dist (caso venha a usar um bundler no futuro) ──
dist/
build/
.cache/
.parcel-cache/
.vite/

# ── Arquivos locais que não devem ir ao repositório ──
*.xlsx
*.csv.local

.private-backup/
.netlify/
.review/
